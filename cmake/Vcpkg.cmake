if(PACKSTACKER_QT_FROM_VCPKG)
    if(NOT PACKSTACKER_BUILD_GUI)
        message(FATAL_ERROR "PACKSTACKER_QT_FROM_VCPKG is only available when PACKSTACKER_BUILD_GUI=ON.")
    endif()
    list(APPEND VCPKG_MANIFEST_FEATURES gui)
    list(REMOVE_DUPLICATES VCPKG_MANIFEST_FEATURES)
elseif("gui" IN_LIST VCPKG_MANIFEST_FEATURES)
    message(FATAL_ERROR "Use PACKSTACKER_QT_FROM_VCPKG=ON to enable the vcpkg gui feature.")
endif()

if(NOT CMAKE_TOOLCHAIN_FILE)
    if(NOT EXISTS "$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
        message(FATAL_ERROR "Set VCPKG_ROOT or CMAKE_TOOLCHAIN_FILE to a vcpkg installation.")
    endif()
    set(CMAKE_TOOLCHAIN_FILE "$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        CACHE FILEPATH "vcpkg toolchain")
endif()

set(VCPKG_INSTALLED_DIR "${CMAKE_SOURCE_DIR}/vcpkg_installed" CACHE PATH "vcpkg installed packages")

set(default_triplet)
if(CMAKE_HOST_WIN32)
    if(PACKSTACKER_QT_FROM_VCPKG)
        set(default_triplet x64-mingw-dynamic)
    else()
        set(default_triplet x64-mingw-static)
    endif()
elseif(PACKSTACKER_QT_FROM_VCPKG AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(default_triplet x64-linux-dynamic)
elseif(PACKSTACKER_QT_FROM_VCPKG AND NOT DEFINED VCPKG_TARGET_TRIPLET)
    message(FATAL_ERROR "Specify VCPKG_TARGET_TRIPLET for this platform.")
endif()

if(default_triplet)
    set(VCPKG_TARGET_TRIPLET "${default_triplet}" CACHE STRING "vcpkg target triplet")
    set(VCPKG_HOST_TRIPLET "${default_triplet}" CACHE STRING "vcpkg host triplet")
endif()
